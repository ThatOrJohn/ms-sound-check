---
import Base from "../layouts/Base.astro";
import { OFM } from "../components/SoundMap";
import Overview from "../components/Overview.astro";
import { loadLatest } from "../lib/data";
import { href } from "../lib/format";

const data = loadLatest();
const persona = data.personas.find((p) => p.id === "general") ?? data.personas[0];
const forPaths = Object.fromEntries(data.personas.filter((p) => p.id !== persona.id).map((p) => [p.id, href(`for/${p.id}/`)]));
---
<Base title={`Sound Check: ${data.region.name} conditions`} description={data.headlines[persona.id]} regionName={data.region.name} current="overview" preconnect={[OFM]} ogImage="index"
  ogAlt={data.history ? `Daily salinity at ${data.history.home.map((s) => s.short).join(" and ")} since ${data.history.since}, one row per year. ${data.history.takeaway ?? ""}`.trim() : undefined}>
  <script slot="head" is:inline define:vars={{ forPaths }}>
    // Someone who picked a view before goes straight to it.
    try { const p = localStorage.getItem("sc-persona"); if (p && forPaths[p]) location.replace(forPaths[p]); } catch (e) {}
  </script>
  <Overview data={data} persona={persona} />
</Base>
