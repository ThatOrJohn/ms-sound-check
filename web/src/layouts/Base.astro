---
import "../styles/global.css";
import ThemePicker from "../components/ThemePicker.astro";
import { href } from "../lib/format";
import { loadLatest } from "../lib/data";
import { OG_H, OG_W } from "../lib/og";

interface Props {
  title: string;
  description: string;
  regionName: string;
  current?: "overview" | "about";
  /** Share image name under og/ (src/pages/og/[name].png.ts). */
  ogImage?: string;
  /** What the share image shows, when it isn't the title and description. */
  ogAlt?: string;
  /** Origins the page will fetch from early (map tiles), so the connection is ready when they're needed. */
  preconnect?: string[];
}
const { title, description, regionName, current, ogImage, ogAlt, preconnect = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The image changes every run under the same name, so the build time in the query keeps share caches honest.
const ogUrl = ogImage && `${new URL(href(`og/${ogImage}.png`), Astro.site)}?v=${loadLatest().generated_at.replace(/\D/g, "").slice(0, 12)}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {preconnect.map((o) => <link rel="preconnect" href={o} crossorigin />)}
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`Sound Check: ${regionName} weekly`} href={href("digest.xml")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Sound Check" />
    {ogUrl && (
      <>
        <meta property="og:image" content={ogUrl} />
        <meta property="og:image:width" content={String(OG_W)} />
        <meta property="og:image:height" content={String(OG_H)} />
        <meta property="og:image:alt" content={ogAlt ?? `${title}. ${description}`} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <meta name="theme-color" content="#f2f4f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d171b" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply the saved theme before first paint so there's no flash.
      try { const t = localStorage.getItem("sc-theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="wide masthead-row">
        <a class="wordmark" href={href()}>
          <svg class="mark" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M5 13.6c2.3-1.9 4.7-1.9 7 0s4.7 1.9 7 0" /><path d="M7 9.4c1.7-1.3 3.3-1.3 5 0s3.3 1.3 5 0" opacity=".55" /></svg>
          <span class="wm-name">Sound Check</span><span class="wm-region">{regionName}</span>
        </a>
        <nav class="nav" aria-label="Site">
          <a href={href()} aria-current={current === "overview" ? "page" : undefined}>Conditions</a>
          <a href={href("about/")} aria-current={current === "about" ? "page" : undefined}>About the data</a>
          <ThemePicker />
        </nav>
      </div>
    </header>
    <main id="main" class="wide">
      <slot />
    </main>
    <footer class="wide foot">
      <div class="foot-grid">
        <p><span class="eyebrow">Sources</span>USGS and Mississippi Department of Marine Resources monitoring stations, the National Weather
          Service, NOAA tides, MDEQ beach monitoring and Open-Meteo. Readings are provisional and can be revised. "Typical" means the
          middle of what each station has recorded for this time of year since monitoring began.</p>
        <p><span class="eyebrow">Not the official record</span>A hobby project, not an official source, and not for navigation or harvest
          decisions. Check <a href="https://beaches.mdeq.ms.gov/">MDEQ</a> for beach advisories and
          <a href="https://dmr.ms.gov/">MDMR</a> for shellfish closures and seasons. <a href={href("about/#official")}>Where our data comes from</a>.</p>
        <p><span class="eyebrow">Feedback</span>Found a wrong number or confusing wording?
          <a href="https://github.com/ThatOrJohn/ms-sound-check/issues" rel="noopener">Open an issue on GitHub</a>. The code is open source
          at <a href="https://github.com/ThatOrJohn/ms-sound-check" rel="noopener">ThatOrJohn/ms-sound-check</a>.</p>
      </div>
    </footer>
  </body>
</html>
