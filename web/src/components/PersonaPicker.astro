---
import type { Persona } from "../lib/types";
interface Props { personas: Persona[]; current: string; paths: Record<string, string> }
const { personas, current, paths } = Astro.props;
const short: Record<string, string> = { general: "Coast", oyster: "Oysters", shrimp: "Shrimp", fish: "Fishing" };
---
<nav class="seg" aria-label="Show conditions for">
  {personas.map((p) => (
    <a href={paths[p.id]} data-persona={p.id} aria-current={p.id === current ? "page" : undefined}>{short[p.id] ?? p.label}</a>
  ))}
</nav>
<script>
  // Remember the choice so the home page opens on it next time.
  document.querySelectorAll<HTMLAnchorElement>("a[data-persona]").forEach((a) =>
    a.addEventListener("click", () => { try { localStorage.setItem("sc-persona", a.dataset.persona!); } catch {} }));
</script>
