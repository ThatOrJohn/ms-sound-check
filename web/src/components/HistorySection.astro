---
import HistoryPanel from "./HistoryPanel.astro";
import HistoryLegend from "./HistoryLegend.astro";
import { loadHistory } from "../lib/data";
import { href } from "../lib/format";
import type { Latest } from "../lib/types";

// The home page's "28 years" section: the region's `history.home` station(s), a takeaway line written at build time
// from per-year counts (decision 0028), and links to every other station's picture (one picture keeps home short, 0036).
interface Props { data: Latest }
const { data } = Astro.props;
const h = data.history!;
const stations = h.home.map((s) => ({ ...s, hist: loadHistory(s.slug) })).filter((s) => s.hist?.years.length);
const shown = new Set(h.home.map((s) => s.id));
const others = Object.entries(h.stations).filter(([id]) => !shown.has(id))
  .map(([id, slug]) => ({ slug, short: data.cards.find((c) => c.id === id)?.short ?? slug }));
---
{stations.length > 0 && (
  <section class="group" aria-labelledby="g-history">
    <div class="group-head">
      <h2 id="g-history">{`${+data.asof.slice(0, 4) - h.since} years of the Sound`}</h2>
      <p>{h.takeaway ?? `Daily salinity since ${h.since}, one row per year.`}</p>
    </div>
    <div class="history-stack">
      {stations.map((s) => (
        <div class="history-card">
          <h3><a href={href(`station/${s.slug}/#history`)}>{s.short}</a></h3>
          <HistoryPanel hist={s.hist!} url={href(`data/${data.region.id}/history/${s.slug}.json`)} legend={false}
            stationHref={href(`station/${s.slug}/`)} mapHref="" />
        </div>
      ))}
    </div>
    <HistoryLegend />
    {others.length > 0 && (
      <p class="history-more">{"The same picture for the other stations: "}{others.map((o, i) => <>{i ? ", " : ""}<a href={href(`station/${o.slug}/#history`)}>{o.short}</a></>)}{"."}</p>
    )}
  </section>
)}
