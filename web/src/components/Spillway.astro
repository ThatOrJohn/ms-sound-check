---
import type { Latest, Spillway, SpillwayPast } from "../lib/types";
import { fmtDate } from "../lib/format";
import OfficialSources from "./OfficialSources.astro";

interface Props { spillway: Spillway; data: Latest }
const { spillway: sp, data } = Astro.props;
const tz = "America/Chicago";
const when = (iso: string) => new Date(iso).toLocaleString("en-US", { weekday: "long", month: "short", day: "numeric", timeZone: tz });
const day = (iso: string) => fmtDate(iso, { month: "short", day: "numeric" });
const r = sp.river;
const open = sp.open_ft;

// ---------- status sentence (strings, not inline JSX: compressHTML drops inline whitespace)
const statusText = !r ? "" : {
  open_level: `At or above ${open} ft, the level where the Corps has opened the spillway. Check the Corps for whether it's open.`,
  forecast_open: `Forecast to reach ${open} ft around ${r.reach_open_time ? when(r.reach_open_time) : "the coming days"}, the level where the Corps has opened the spillway.`,
  watch: `Within ${open - sp.watch_ft} ft of ${open} ft, the level where the Corps has opened the spillway.`,
  low: `${(open - Math.max(r.stage, r.crest ?? 0)).toFixed(0)} ft or more below the ${open}-ft level where the Corps has opened the spillway, through the end of the forecast.`,
}[r.status];
const trend = !r || r.change_24h == null ? "" : Math.abs(r.change_24h) < 0.1 ? "steady" : r.change_24h > 0 ? `up ${r.change_24h.toFixed(1)} ft in 24 hours` : `down ${Math.abs(r.change_24h).toFixed(1)} ft in 24 hours`;
const sub = r ? `${sp.gauge_name}${trend ? `, ${trend}` : ""}.` + (r.crest != null && r.crest_time ? ` NWS forecast peak ${r.crest.toFixed(1)} ft around ${when(r.crest_time)}.` : "") : "";

// ---------- stage bar (same look as the oyster watch)
const top = Math.max(20, ...(r ? [r.stage + 1, (r.crest ?? 0) + 1] : []));
const pct = (v: number) => `${Math.max(0, Math.min(100, (v / top) * 100)).toFixed(1)}%`;

// ---------- 30 days observed + forecast, as a small SVG chart
// Lines in a stretched SVG; labels in HTML (positioned in %) so they stay readable at phone width.
const W = 600, H = 100, PAD = { l: 0, r: 0, t: 0, b: 0 };
const pts = r ? [...r.observed, ...r.forecast] : [];
const t0 = pts.length ? Date.parse(pts[0][0]) : 0, t1 = pts.length ? Date.parse(pts.at(-1)![0]) : 1;
const yTop = Math.max(20, ...pts.map((p) => p[1] + 1));
const x = (iso: string) => PAD.l + ((Date.parse(iso) - t0) / Math.max(1, t1 - t0)) * (W - PAD.l - PAD.r);
const y = (v: number) => PAD.t + (1 - Math.max(0, v) / yTop) * (H - PAD.t - PAD.b);
const path = (xs: [string, number][]) => xs.map((p, i) => `${i ? "L" : "M"}${x(p[0]).toFixed(1)},${y(p[1]).toFixed(1)}`).join("");
const fcLine = r && r.forecast.length ? path([r.observed.at(-1) ?? r.forecast[0], ...r.forecast]) : "";
const nowX = r ? x(r.time) : 0;
const yTicks = [0, 5, 10, 15, 20].filter((v) => v <= yTop);
const left = (px: number) => `${((px / W) * 100).toFixed(2)}%`, topPct = (px: number) => `${((px / H) * 100).toFixed(2)}%`;
const chartLabel = r ? `River stage at New Orleans over the past 30 days and the NWS forecast. Now ${r.stage.toFixed(1)} ft` +
  (r.crest != null ? `, forecast peak ${r.crest.toFixed(1)} ft` : "") + `; the Corps has opened the spillway near ${open} ft.` : "";

// ---------- timeline of every opening since 1937
const y0 = 1930, y1 = Math.max(2030, new Date().getFullYear() + 1);
const tx = (yr: number) => `${(((yr - y0) / (y1 - y0)) * 100).toFixed(2)}%`;
const decades = Array.from({ length: Math.floor((y1 - y0) / 20) + 1 }, (_, i) => y0 + i * 20).filter((d) => d < y1);
const last = sp.openings.at(-1);
const historyLine = sp.count
  ? `Opened ${sp.count} times since ${sp.since}, ${sp.since_2000} of them since 2000.` +
    (last ? ` The last time was ${new Date(last.opened + "T12:00:00").toLocaleString("en-US", { month: "long", year: "numeric" })}${last.days ? `, for ${last.days} days` : ""}.` : "")
  : "";
const timelineLabel = `Spillway openings by year: ${sp.openings.map((o) => `${o.year}${o.days ? ` (${o.days} days)` : ""}`).join(", ")}.`;

// ---------- what our station did after each past opening, one small chart per year on the same axes (0038)
const PW = 300, PH = 100, D0 = -28, D1 = 196;
const pTop = Math.max(20, Math.ceil(Math.max(0, ...sp.past.flatMap((p) => p.series.map((s) => s[1]))) / 5) * 5);
const px = (d: number) => ((d - D0) / (D1 - D0)) * PW;
const py = (v: number) => (1 - Math.max(0, v) / pTop) * PH;
const line = (pts: [number, number][]) => pts.map((p, i) =>
  `${i && p[0] - pts[i - 1][0] <= 3 ? "L" : "M"}${px(p[0]).toFixed(1)},${py(p[1]).toFixed(1)}`).join("");
const span = (d: number) => d < 14 ? `${d} day${d === 1 ? "" : "s"}` : `${Math.round(d / 7)} weeks`;
const pastHead = (p: SpillwayPast) =>
  `${p.year}: opened ${p.opened.map(day).join(" and ")}` + (p.days_open ? `, ${p.days_open} days in all` : "");
const pastLine = (p: SpillwayPast) =>
  `About ${p.before.toFixed(0)} ppt in the 4 weeks before. Lowest ${p.low.toFixed(1)} ppt, ${span(p.low_day)} after it ` +
  `${p.opened.length > 1 ? "first " : ""}opened. ` +
  (p.fresh_run >= 3 ? `Under ${sp.fresh_ppt} ppt for ${p.fresh_run} days in a row.`
    : p.low < sp.fresh_ppt ? `Under ${sp.fresh_ppt} ppt for only a day or two at a time.` : `Never under ${sp.fresh_ppt} ppt.`);
const xTicks: [number, string][] = [[0, "opened"], [84, "+12 wks"], [D1, "+28 wks"]];
const missed = [...new Set(sp.openings.filter((o) => o.year >= 2000).map((o) => o.year))].filter((y) => !sp.past.some((p) => p.year === y));

// ---------- calm: the river is well below the opening level and nothing is open, so the section is one line and the
// rest folds into a details element (decision 0036). Any watch, forecast or opening shows everything.
const calm = !!r && r.status === "low" && !sp.open_now;
const calmLine = r ? `${r.stage.toFixed(1)} ft on the ${sp.gauge_name.replace(/^Mississippi River/, "Mississippi")}${trend ? `, ${trend}` : ""}. ${statusText}` : "";
const Body = calm ? "details" : "div";
---
<section class="group spillway" aria-labelledby="g-spillway">
  <h2 id="g-spillway">Bonnet Carré Spillway</h2>
  <OfficialSources data={data} only="spillway" />
  {calm && <p class="spill-calm">{calmLine}</p>}
  <Body class={calm ? "spill-more" : "spill-body"}>
  {calm && <summary>{`What the spillway is, the river chart, and what ${sp.sound_site} did after past openings`}</summary>}
  <p>When the Mississippi runs high, the Army Corps of Engineers opens this spillway above New Orleans to take pressure
    off the city's levees. The river water flows through Lake Pontchartrain and Lake Borgne into the western Sound. In
    2019, two long openings kept the western Sound fresh for months, and most of the oysters on its reefs died. Only the Corps
    decides when it opens.</p>

  {sp.open_now && (
    <p class="spill-open">{`The Corps opened the spillway on ${fmtDate(sp.open_now.opened, { month: "long", day: "numeric" })}. `}<a href={sp.link ?? "#"}>Current status from the Corps</a>.</p>
  )}

  {!r ? (
    <p class="quiet-note">River readings at New Orleans aren't available right now.</p>
  ) : (
    <div class="stage-now" data-status={r.status}>
      <p class="stage-val">{r.stage.toFixed(1)} ft</p>
      <p class="stage-sub">{sub}</p>
      <p class="spill-status">{statusText}</p>
      <div class="stage-bar" role="img" aria-label={`Stage ${r.stage.toFixed(1)} feet; the Corps has opened the spillway near ${open} feet`}>
        <span class="stage-fill" style={`width:${pct(r.stage)}`}></span>
        {r.crest != null && r.crest > r.stage && (
          <span class="stage-fc" style={`left:${pct(r.stage)};width:calc(${pct(r.crest)} - ${pct(r.stage)})`}></span>
        )}
        <span class="stage-mark" style={`left:${pct(open)}`}><span>{`${open} ft`}</span></span>
      </div>
      {pts.length > 1 && (
        <div class="spill-chart" role="img" aria-label={chartLabel}>
          <div class="plot" aria-hidden="true">
            <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
              {yTicks.map((v) => <line class="grid" x1="0" x2={W} y1={y(v)} y2={y(v)} vector-effect="non-scaling-stroke" />)}
              <line class="open-line" x1="0" x2={W} y1={y(open)} y2={y(open)} vector-effect="non-scaling-stroke" />
              <line class="now-line" x1={nowX} x2={nowX} y1="0" y2={H} vector-effect="non-scaling-stroke" />
              <path class="obs" d={path(r.observed.length ? r.observed : [[r.time, r.stage]])} vector-effect="non-scaling-stroke" />
              {fcLine && <path class="fc" d={fcLine} vector-effect="non-scaling-stroke" />}
            </svg>
            {yTicks.map((v) => <span class="tick y" style={`top:${topPct(y(v))}`}>{v}</span>)}
            <span class="open-label" style={`top:${topPct(y(open))}`}>{`Opened near ${open} ft`}</span>
          </div>
          <div class="x" aria-hidden="true">
            <span class="tick" style="left:0">{day(pts[0][0])}</span>
            <span class="tick at-now" style={`left:${left(nowX)}`}>now</span>
            <span class="tick" style="right:0">{day(pts.at(-1)![0])}</span>
          </div>
        </div>
      )}
    </div>
  )}

  {sp.past.length > 0 && (
    <div class="spill-past">
      <h3>{`What ${sp.sound_site} did after past openings`}</h3>
      <p>{`Each picture runs from 4 weeks before the spillway opened to 28 weeks after, on the same scale. These are past ` +
        `openings side by side, not a forecast of the next one.`}</p>
      <p class="past-key" aria-hidden="true">
        <span><i class="k-obs"></i>{`${sp.sound_site} salinity (ppt)`}</span>
        <span><i class="k-typ"></i>typical for the time of year</span>
        <span><i class="k-open"></i>spillway open</span>
      </p>
      <div class="past-grid">
        {sp.past.map((p) => (
          <figure class="past-year">
            <figcaption>{pastHead(p)}</figcaption>
            <div class="past-chart" role="img" aria-label={`${sp.sound_site} salinity around the ${p.year} opening. ${pastLine(p)}`}>
              <div class="plot" aria-hidden="true">
                <svg viewBox={`0 0 ${PW} ${PH}`} preserveAspectRatio="none">
                  {p.bands.map(([a, b]) => <rect class="open-band" x={px(a)} y="0" width={Math.max(1, px(Math.min(b, D1)) - px(a))} height={PH} />)}
                  <line class="fresh-line" x1="0" x2={PW} y1={py(sp.fresh_ppt)} y2={py(sp.fresh_ppt)} vector-effect="non-scaling-stroke" />
                  {p.typical.length > 1 && <path class="typ" d={line(p.typical)} vector-effect="non-scaling-stroke" />}
                  <path class="obs" d={line(p.series)} vector-effect="non-scaling-stroke" />
                </svg>
                <span class="tick y" style="top:0%">{`${pTop}`}</span>
                <span class="tick y fresh" style={`top:${((py(sp.fresh_ppt) / PH) * 100).toFixed(1)}%`}>{`${sp.fresh_ppt}`}</span>
              </div>
              <div class="x" aria-hidden="true">
                {xTicks.map(([d, t]) => <span class="tick" style={`left:${((px(d) / PW) * 100).toFixed(1)}%`} data-edge={d === D0 ? "l" : d === D1 ? "r" : undefined}>{t}</span>)}
              </div>
            </div>
            <p>{pastLine(p)}</p>
          </figure>
        ))}
      </div>
      <p class="oyster-notes">{`From our station's daily readings. The rivers along the coast were often high in the same ` +
        `springs, so not all of each drop is the spillway's. Oyster reefs start dying when the water stays under ` +
        `${sp.fresh_ppt} ppt for more than two weeks.` +
        (missed.length ? ` ${missed.join(" and ")} ${missed.length > 1 ? "aren't" : "isn't"} shown: the station has too few readings around ${missed.length > 1 ? "those openings" : "that opening"}.` : "")}</p>
    </div>
  )}

  {sp.count > 0 && (
    <div class="spill-history">
      <h3>Every opening since {sp.since}</h3>
      <p>{historyLine}</p>
      <div class="spill-timeline" role="img" aria-label={timelineLabel}>
        <span class="axis"></span>
        {decades.map((d) => <span class="decade" style={`left:${tx(d)}`}>{d}</span>)}
        {sp.openings.map((o) => (
          <span class="opening" data-recent={o.year >= 2000 ? "" : undefined}
            style={`left:${tx(o.year + 0.5)};--d:${Math.max(6, Math.min(18, 6 + (o.days ?? 30) / 7)).toFixed(1)}px`}></span>
        ))}
      </div>
      <p class="spill-key">Each dot is an opening; bigger dots stayed open longer.</p>
    </div>
  )}

  </Body>
  <p class="oyster-notes">
    River stage and forecast from the National Weather Service. Opening dates from the Corps' operation history, kept
    by hand here. <a href={sp.link ?? "https://www.mvn.usace.army.mil/"}>Bonnet Carré Spillway, US Army Corps of Engineers</a>.
  </p>
</section>
