---
import type { Latest, OysterWatch } from "../lib/types";
import { fmtDate, href } from "../lib/format";
import MdmrNotices from "./MdmrNotices.astro";
import OfficialSources from "./OfficialSources.astro";

interface Props { watch: OysterWatch; gaugeSlug?: string; data: Latest }
const { watch, gaugeSlug, data } = Astro.props;
const page = watch.season;
const changed = (d: string) => fmtDate(d, { month: "short", day: "numeric", year: "numeric" });
const tz = "America/Chicago";
const when = (iso: string) =>
  new Date(iso).toLocaleString("en-US", { weekday: "long", month: "short", day: "numeric", hour: "numeric", timeZone: tz });
const statusText: Record<string, string> = {
  above: "At or above the closure level",
  forecast: "Forecast to reach the closure level",
  near: "Within 2 ft of the closure level",
  clear: "Well below the closure level",
};
const g = watch.gauge;
const nowText = (x: NonNullable<OysterWatch["groups"]>[number]) =>
  statusText[x.status] + (x.status === "forecast" && x.crossing_time ? `, around ${when(x.crossing_time)}` : "") + ".";
// Scale for the stage bar: from 0 to a bit past the highest of stage, forecast and thresholds.
const thresholds = (watch.groups ?? []).map((x) => x.stage_ft);
const top = Math.max(14, ...(g ? [g.stage + 1] : []), ...(watch.forecast?.max ? [watch.forecast.max + 1] : []), ...thresholds.map((t) => t + 2));
const pct = (v: number) => `${Math.max(0, Math.min(100, (v / top) * 100)).toFixed(1)}%`;
const month = (m: number) => new Date(2000, m - 1, 1).toLocaleString("en-US", { month: "long" });
// One sentence covering every closure level, built as a string (inline whitespace gets dropped under compressHTML).
const levels = [...new Map((watch.groups ?? []).filter((x) => x.history).map((x) => [x.stage_ft, x.history!])).entries()]
  .sort((a, b) => a[0] - b[0]);
const historyLine = levels.length === 0 ? "" :
  `Since ${levels[0][1].since}, the river's daily average has reached ` +
  levels.map(([ft, h]) => {
    const pm = h.peak_months;
    const peak = pm.length === 2 && pm[1] > pm[0] ? `${month(pm[0])} to ${month(pm[1])}` : pm.map(month).join(", ");
    return `${ft} ft on about ${h.days_per_year} days in a typical year (most often ${peak}; ${h.this_month_pct}% of days in ${month(h.month)})`;
  }).join(" and ") + ". High water is common here, so these levels say how often the river is up, not how often areas close.";
const trend = g?.change_24h == null ? "" : Math.abs(g.change_24h) < 0.1 ? "steady" : g.change_24h > 0 ? `up ${g.change_24h.toFixed(1)} ft in 24 hours` : `down ${Math.abs(g.change_24h).toFixed(1)} ft in 24 hours`;
---
<section class="group oyster-watch" aria-labelledby="g-oyster">
  <h2 id="g-oyster">Oyster closure watch</h2>
  <OfficialSources data={data} only="oyster" />
  <p>MDMR closes the conditionally approved reefs in the western Sound when the Pearl River runs high or after heavy
    rain. This compares today's readings with the criteria in its <a href={watch.plan_url}>management plan</a>.
    Only MDMR decides closures.</p>

  {!watch.available || !g ? (
    <p class="quiet-note">River stage readings aren't available right now.</p>
  ) : (
    <>
      <div class="stage-now">
        <p class="stage-val">{g.stage.toFixed(1)} ft</p>
        <p class="stage-sub">
          Pearl River near Pearl River, LA{trend && <>, {trend}</>}.
          {watch.forecast?.max != null && watch.forecast.max_time && (
            <> NWS forecast peak {watch.forecast.max.toFixed(1)} ft around {when(watch.forecast.max_time)}.</>
          )}
          {watch.stale && <span class="warn"> This reading is more than a day old.</span>}
        </p>
        <div class="stage-bar" role="img"
          aria-label={`Stage ${g.stage.toFixed(1)} feet; closure levels at ${thresholds.join(" and ")} feet`}>
          <span class="stage-fill" style={`width:${pct(g.stage)}`}></span>
          {watch.forecast?.max != null && watch.forecast.max > g.stage && (
            <span class="stage-fc" style={`left:${pct(g.stage)};width:calc(${pct(watch.forecast.max)} - ${pct(g.stage)})`}></span>
          )}
          {thresholds.map((t) => <span class="stage-mark" style={`left:${pct(t)}`}><span>{t} ft</span></span>)}
        </div>
      </div>

      <table class="oyster-table">
        <thead><tr><th>Areas</th><th>River closure level</th><th>Rain closure level (24 h)</th><th>Now</th></tr></thead>
        <tbody>
          {watch.groups!.map((x) => (
            <tr data-status={x.status}>
              <td><strong>{x.areas.join(", ")}</strong>{x.names && <span class="reefs">{x.names}</span>}</td>
              <td>{x.stage_ft} ft</td>
              <td>{x.rain_in ? Object.entries(x.rain_in).map(([a, v]) => `${a}: ${v} in`).join("; ") : "—"}</td>
              <td class="now-cell">
                {nowText(x)}{x.rain_triggered.length > 0 && <span class="warn">{` Rain criterion met for ${x.rain_triggered.join(", ")}.`}</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {historyLine && <p class="oyster-notes">{historyLine}</p>}
      {data.shellfish_areas && <p class="oyster-notes">{"These areas are outlined on the map above: turn on Oyster growing areas under Layers."}</p>}
      <p class="oyster-notes">
        {watch.rain?.yesterday_in != null && <>Rain in Hancock County yesterday: about {watch.rain.yesterday_in.toFixed(2)} in. </>}
        Our rain figure is an estimate; MDMR measures at the Hancock County Utility Authority gauge. Areas reopen once the
        river falls below its level or crests and water samples pass, after time for the oysters to cleanse.
        {gaugeSlug && <> <a href={href(`station/${gaugeSlug}/`)}>Stage history and forecast</a>.</>}
      </p>
    </>
  )}
  {watch.notices_available !== undefined && (
    <MdmrNotices notices={watch.notices ?? []} available={watch.notices_available} topic="oyster"
      link={watch.notices_link ?? watch.status_url ?? "https://dmr.ms.gov/shellfish/"} linkText="MDMR's shellfish page" />
  )}
  {page && (page.summary.length > 0 || page.orders.length > 0) && (
    <>
      <h3 class="notices-sub">{page.season ? `The ${page.season} season, from MDMR` : "This season, from MDMR"}</h3>
      {page.summary.length > 0 && (
        <blockquote class="mdmr-quote" cite={page.link}>{page.summary.map((t) => <p>{t}</p>)}</blockquote>
      )}
      {page.no_harvest && page.no_harvest.days.length > 0 && (
        <div class="mdmr-quote">
          <p>{page.no_harvest.lead}</p>
          <ul>{page.no_harvest.days.map((d) => <li>{d}</li>)}</ul>
        </div>
      )}
      {page.orders.length > 0 && (
        <>
          <p class="oyster-notes">{"MDMR's orders this season, newest first:"}</p>
          <ol class="notices mdmr-orders">{page.orders.slice().reverse().map((o) => <li><a href={o.link}>{o.title}</a></li>)}</ol>
        </>
      )}
      <p class="oyster-notes">{`Quoted from MDMR's season page, last changed ${changed(page.modified)}. A new order can come before the page catches up. `}<a href={page.link}>MDMR's season page</a>.</p>
    </>
  )}
  <p class="oyster-notes">
    For what's open today: <a href={watch.status_url ?? "https://dmr.ms.gov/"}>MDMR shellfish</a>
    {watch.hotline && <> or the oyster information line, {watch.hotline}</>}.
  </p>
</section>
