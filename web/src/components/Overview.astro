---
import type { Latest, Persona } from "../lib/types";
import { GROUPS, SEV_LABEL, SEV_RANK, forPersona, href, personaPath } from "../lib/format";
import PersonaPicker from "./PersonaPicker.astro";
import Freshness from "./Freshness.astro";
import StationList from "./StationList";
import BeachStatus from "./BeachStatus.astro";
import OysterWatch from "./OysterWatch.astro";
import FishingOutlook from "./FishingOutlook.astro";
import ShrimpSeason from "./ShrimpSeason.astro";
import Spillway from "./Spillway.astro";
import VibrioNote from "./VibrioNote.astro";
import OfficialSources from "./OfficialSources.astro";
import SoundMap, { type MapRiver, type MapStation } from "./SoundMap";
import TideStrip from "./TideStrip";
import ReadingRow from "./ReadingRow";
import Meter from "./Meter";
import { readoutTiles } from "../lib/readouts";

interface Props { data: Latest; persona: Persona }
const { data, persona } = Astro.props;

const showsBeaches = !!data.beaches && persona.card_order.includes("beaches");
const showsOyster = !!data.oyster_watch && persona.card_order.includes("oyster_watch");
// Beach advisories and oyster-watch findings have their own sections; don't list them twice.
const findings = forPersona(data.findings, persona)
  .filter((f) => !(showsBeaches && f.var === "beach") && !(showsOyster && f.indicator === "oyster_closure_watch"));
const dates = data.cards.flatMap((c) => Object.values(c.vars)).map((v) => v.date).filter(Boolean).sort() as string[];
const newest = dates.at(-1) ?? null;
const paths = Object.fromEntries(data.personas.map((p) => [p.id, personaPath(p.id)]));
const siteHref = (slug: string) => href(`station/${slug}/`);
const alerting = new Set(data.findings.filter((f) => f.site && SEV_RANK[f.severity] >= 2).map((f) => f.site));
// A retired station stays on the map only while it has a published estimate; otherwise it would just say "offline".
const mapStations: MapStation[] = data.cards.filter((c) => (c.kind === "sound" || c.kind === "estuary") && !(c.retired && !c.vars.salinity?.estimate)).map((c) => {
  const v = c.vars.salinity ?? {};
  const live = v.value !== undefined && !v.stale && !c.retired;
  const status: MapStation["status"] = live ? (v.suspect ? "suspect" : "live") : v.estimate ? "estimate" : "quiet";
  const salinity = status === "live" ? v.value ?? null : status === "estimate" ? v.estimate!.value : null;
  const display = status === "estimate" ? `~${v.estimate!.display} est.` : c.retired ? "offline" : v.display ?? "no data";
  return { id: c.id, short: c.short, kind: c.kind, lon: c.lon, lat: c.lat, href: siteHref(c.slug),
    salinity, display, status, alert: alerting.has(c.id) };
});
const mapRivers: MapRiver[] = data.cards.filter((c) => c.kind === "river").map((c) => ({
  id: c.id, name: c.short, osmNames: c.osm_names ?? [c.short], display: c.vars.flow?.display ?? "no data",
  band: c.vars.flow?.band, percentile: c.vars.flow?.percentile,
}));
const ungauged = data.ungauged_rivers ?? [];
const ungaugedNote = ungauged.length ? "Smaller rivers without a live flow gauge also reach the Sound: " +
  ungauged.map((r, i) => `${i && i === ungauged.length - 1 ? "and " : ""}the ${r.name} into ${r.into}`).join(ungauged.length > 2 ? ", " : " ") +
  ". They're drawn on the map." : null;
const groups = persona.card_order
  .map((kind) => ({ kind, ...(GROUPS[kind] ?? { title: kind, blurb: "" }), cards: data.cards.filter((c) => c.kind === kind) }))
  .filter((g) => g.kind === "beaches" ? !!data.beaches : g.kind === "oyster_watch" ? !!data.oyster_watch
    : g.kind === "fishing_outlook" ? !!data.fishing_outlook : g.kind === "shrimp_season" ? !!data.shrimp_season : g.kind === "spillway" ? !!data.spillway : g.kind === "vibrio" ? !!data.vibrio : g.cards.length);
const gaugeSlug = data.cards.find((c) => c.kind === "gauge")?.slug;

const tiles = readoutTiles(data, siteHref);
const alertCount = findings.filter((f) => SEV_RANK[f.severity] >= 2).length;
---
<script>import "../lib/live";</script>

<section class="hero" aria-labelledby="headline">
  <div class="hero-bar">
    <PersonaPicker personas={data.personas} current={persona.id} paths={paths} />
    <Freshness newest={newest} generatedAt={data.generated_at} />
  </div>
  <p class="eyebrow">{data.region.name} · {persona.label}</p>
  <h1 id="headline">{data.headlines[persona.id]}</h1>
  <p class="persona-blurb">{persona.blurb}</p>
</section>

<OfficialSources data={data} />

{tiles.length > 0 && (
  <section class="readouts" aria-label="Key readings right now">
    {tiles.slice(0, 6).map((t) => (
      <div class="readout" data-live={t.live}>
        <p class="readout-label">{t.href ? <a href={t.href}>{t.label}</a> : t.label}</p>
        <p class="readout-val"><span data-live-value>{t.value}</span><span class="unit">{t.unit}</span></p>
        <p class="readout-sub"><Meter percentile={t.percentile} small /><span data-live-text>{t.sub}</span></p>
      </div>
    ))}
  </section>
)}

<div class="console">
  <figure class="sound panel-flat" aria-labelledby="sound-cap">
    <div class="panel-title">
      <h2 class="eyebrow">The Sound, live</h2>
      <span class="scale" aria-hidden="true"><span>Fresh</span><span class="scale-bar"></span><span>Gulf</span></span>
    </div>
    <SoundMap client:only="react" stations={mapStations} rivers={mapRivers} ungauged={ungauged.flatMap((r) => r.osm_names)}
      basemapBase={href("basemap/")} beachesUrl={data.beaches ? href(`data/${data.region.id}/beaches.geojson`) : undefined}
      personaId={persona.id} defaultLayers={persona.map_layers}
      satellite={data.satellite} dataBase={href(`data/${data.region.id}/`)} replay={data.replay} beachLinks={showsBeaches}
      reference={data.reference} />
    {data.tide_strip && <TideStrip client:only="react" strip={data.tide_strip} />}
    <figcaption class="sound-foot" id="sound-cap">{"Stations are colored by salinity. River lines widen when the rivers run high; dashed lines are rivers without a flow gauge."}</figcaption>
    <StationList cards={data.cards} findings={data.findings} siteHref={siteHref} />
  </figure>

  <aside class="rail" aria-labelledby="findings-h">
    <div class="rail-head">
      <h2 id="findings-h" class="eyebrow">Signals</h2>
      <span class="count" data-hot={alertCount > 0 ? "" : undefined}>{findings.length ? `${findings.length} active` : "All quiet"}</span>
    </div>
    {findings.length ? (
      <ul class="signals">
        {findings.map((f) => (
          <li class="finding" data-sev={f.severity}>
            <span class="sev">{SEV_LABEL[f.severity]}</span>
            <span class="finding-text">{f.text}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="quiet-note">Nothing stands out for {persona.label.toLowerCase()} right now. Everything is within the normal range for {data.season}.</p>
    )}
  </aside>
</div>

<div class="sections">
{groups.map((g) => g.kind === "beaches" ? <BeachStatus beaches={data.beaches!} data={data} />
  : g.kind === "oyster_watch" ? <OysterWatch watch={data.oyster_watch!} gaugeSlug={gaugeSlug} data={data} />
  : g.kind === "fishing_outlook" ? <FishingOutlook outlook={data.fishing_outlook!} data={data} />
  : g.kind === "shrimp_season" ? <ShrimpSeason season={data.shrimp_season!} data={data} />
  : g.kind === "spillway" ? <Spillway spillway={data.spillway!} data={data} />
  : g.kind === "vibrio" ? <VibrioNote vibrio={data.vibrio!} /> : (
  <section class="group" aria-labelledby={`g-${g.kind}`}>
    <div class="group-head">
      <h2 id={`g-${g.kind}`}>{g.title}</h2>
      {g.blurb && <p>{g.blurb}</p>}
    </div>
    <div class="cards">
      {g.cards.map((c) => (
        <article class="card">
          <h3><a href={siteHref(c.slug)}>{c.short}</a></h3>
          <p class="where">{c.name}</p>
          {Object.entries(c.vars).map(([vn, r]) => (
            <ReadingRow varName={vn} label={data.variables[vn]?.label ?? vn} r={r} forecast={vn === "rain" ? data.rain_forecast[c.id]?.total : undefined} retired={c.retired} />
          ))}
        </article>
      ))}
    </div>
    {g.kind === "river" && ungaugedNote && <p class="quiet-note">{ungaugedNote}</p>}
  </section>
))}
</div>
